{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @mirusync/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron-notify",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/[route]"
    },
    {
      "source": "/((?!api/|assets/|scenes/|logo\\.svg|logo\\.png|manifest\\.webmanifest|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
